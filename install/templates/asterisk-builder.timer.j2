{% if ansible_architecture == "x86_64" %}
[Unit]
Description=Six-hourly Zamfono Asterisk freshness check

[Timer]
OnCalendar=*-*-* 00/6:00:00
RandomizedDelaySec=15m
Persistent=true
{% else %}
# A follower builds what the amd64 primary published; polling the archive
# every five minutes starts that build within minutes of the publish.
[Unit]
Description=Five-minutely Zamfono Asterisk follower check

[Timer]
OnCalendar=*:0/5
Persistent=true
{% endif %}

[Install]
WantedBy=timers.target
